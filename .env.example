APP_NAME=NILES
# Nome del sito pubblico / del comitato (tag <title> delle pagine pubbliche), distinto da APP_NAME.
# Impostalo per ogni installazione. Se vuoto, usa APP_NAME.
# (Denominazione, contatti, IBAN e simili si gestiscono dal pannello "Dati comitato", non qui.)
APP_PUBLIC_NAME="Croce Rossa Italiana – Comitato di ..."
# In produzione: APP_ENV=production e APP_DEBUG=false (con il debug acceso gli errori mostrano dettagli interni).
# APP_URL è l'indirizzo pubblico completo del sito, con https://.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Primo amministratore creato da `php artisan db:seed` (solo se non esiste alcun admin).
# Senza email vale administrator@example.it; senza password ne viene generata una casuale, mostrata una
# sola volta a fine comando. L'accesso con password è disponibile da /admin/login/password.
# INITIAL_ADMIN_EMAIL=nome@dominio.it
# INITIAL_ADMIN_PASSWORD=

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

# Fuso orario "da muro" del comitato: date/orari dei corsi sono salvati come ora locale (l'app gira in UTC).
# Se non impostato vale Europe/Rome.
# COMMITTEE_TIMEZONE=Europe/Rome

# Controllo aggiornamenti: la dashboard del pannello (solo amministratori) confronta la versione installata con
# l'ultima release pubblicata su GitHub, con un risultato in cache per 24 ore. Attivo se non impostato;
# false lo disattiva (nessuna richiesta verso l'esterno).
# NILES_UPDATE_CHECK=false

# Modalità dimostrativa, per un sito di prova pubblico: il pannello e il sito si possono usare ma nessuna
# modifica viene salvata (pannello e moduli pubblici), con una fascia di avviso in alto e le credenziali
# mostrate nelle pagine di login. Il login resta attivo. Usa MAIL_MAILER=log e NILES_UPDATE_CHECK=false.
# NILES_DEMO=false
# Account di prova da mostrare nel login, oltre all'amministratore (INITIAL_ADMIN_*), separati da «|».
# NILES_DEMO_ACCOUNTS="Editor: editor@example.test / password|Redattore: redattore@example.test / password"

# Modalità manutenzione (`php artisan down`): lo stato si salva su file.
APP_MAINTENANCE_DRIVER=file

# Staging con dati condivisi con la produzione (test/upgrade prima di passarli in produzione): il sito
# pubblico è invisibile a chi non è già loggato su /admin nello stesso browser. Lascia false/assente
# ovunque tranne su quell'istanza di staging dedicata.
# STAGING_GATE_PUBLIC=true

# Solo per `php artisan serve` in locale: numero di processi del server di prova.
# PHP_CLI_SERVER_WORKERS=4

# Costo dell'hash delle password (più alto = più lento e più sicuro).
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# In produzione conviene `warning` o `error`.
LOG_LEVEL=debug

# MySQL / MariaDB (i test automatici usano SQLite in memoria, vedi phpunit.xml).
# Usa un database vuoto e un utente dedicato, non root; se la password contiene caratteri speciali
# (# $ = ? spazi) scrivila tra virgolette doppie.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=niles
DB_USERNAME=niles
DB_PASSWORD=

# --- Statistiche (vedi config/tracking.php) ---
# Qui si indica QUALE strumento usare e con quale indirizzo o codice: dipende dall'installazione e non si
# imposta dal pannello. Dal pannello («Dati del comitato» → Statistiche) si possono solo accendere o spegnere
# i due strumenti, e solo se sono definiti qui. Senza queste righe non viene caricata nessuna statistica.
# Cookieless, sempre attivo (nessun consenso): <script> di GoatCounter (hosted o self-host).
# Self-host (proprio sottodominio, es. stats.<dominio>.it): src e endpoint sullo stesso sottodominio.
# ANALYTICS_COOKIELESS_SRC=//stats.example.org/count.js
# ANALYTICS_COOKIELESS_ENDPOINT=https://stats.example.org/count
# Alternativa: servizio gratuito ospitato da GoatCounter (basso traffico) — src fisso su gc.zgo.at,
# endpoint sul proprio sottodominio <codice>.goatcounter.com:
# ANALYTICS_COOKIELESS_SRC=//gc.zgo.at/count.js
# ANALYTICS_COOKIELESS_ENDPOINT=https://<codice>.goatcounter.com/count
# Google Analytics 4: opt-in dal banner cookie, opzionale e a rischio del comitato.
# GA4_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null = il cookie vale per il dominio corrente.
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Posta in uscita (codice di accesso via email, email di iscrizione ai corsi). Con `log` le email non vengono
# spedite: finiscono solo in storage/logs/laravel.log, e solo con LOG_LEVEL=debug (con `warning` o `error` non
# si scrive nulla).
# In produzione usa un vero SMTP (MAIL_MAILER=smtp, con host, porta,
# utente, password e, se serve, MAIL_SCHEME=smtps). Le chiavi CAPTCHA (Turnstile) e i testi delle email
# stanno nel pannello e nel database.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_PUBLIC_NAME}"
